VITE_FIREANT_ACCESS_TOKEN=
VITE_FIREANT_BASE_URL=https://restv2.fireant.vn
VITE_TRADESTATION_BASE_URL=https://tradestation.fireant.vn
VITE_FIREANT_AI_BASE_URL=https://openai.fireant.vn/v1
VITE_STATIC_FIREANT_URL=https://static.fireant.vn
VITE_OIDC_AUTHORITY=https://accounts.fireant.vn
VITE_OIDC_CLIENT_ID=
# Leave empty in Vercel/browser builds to use window.location.origin.
# For local dev the app runs at http://localhost:3000 — the OIDC provider must have
# http://localhost:3000/signin-callback (+ /signout-callback, /silent-renew-callback) registered.
VITE_APP_BASE_URL=http://localhost:3000

# Comma-separated FireAnt account emails that are ADMINS. These always get access and are always
# admin (can open /admin to authorize other accounts). Leave EMPTY to disable access control
# (any FireAnt login is allowed, like before). Access enforcement turns on once at least one admin exists.
ADMIN_FIREANT=
SESSION_SECRET=

# AI gateway. OPENAI_API_KEY defaults to VITE_FIREANT_ACCESS_TOKEN when omitted.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openai.fireant.vn/v1
OPENAI_DEFAULT_MODEL=gpt-5.4-mini

# Server-side API URLs. Set these in Vercel when they differ from defaults.
FIREANT_BASE_URL=https://restv2.fireant.vn
TRADESTATION_BASE_URL=https://tradestation.fireant.vn
STATIC_FIREANT_URL=https://static.fireant.vn
